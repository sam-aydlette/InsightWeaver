# The Anthropic API key is NOT read from this file any more (2026-09-22,
# backlog task 026). It lives in the OS keychain. Set it once with:
#
#     estate auth set anthropic
#
# Position and the watch set are hand-authored and live in your private repo,
# not this one. Defaults: ~/.config/insightweaver/{position,watches}.yaml
POSITION_PATH=~/.config/insightweaver/position.yaml
WATCHES_PATH=~/.config/insightweaver/watches.yaml

# Where the model audit log is written. Keep it out of any cloud-synced folder.
# Default: ./data/llm-audit under the checkout.
# LLM_AUDIT_DIR=~/.local/state/insightweaver/llm-audit
