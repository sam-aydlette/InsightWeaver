      "any_of": [["allow*", "restriction*", "sides with", "stay"]]
    },
    {
      "date": "2026-08-24",
      "what": "FedRAMP director reinstated",
      "terms": ["FedRAMP"],
      "any_of": [
        ["director", "administrator"],
        ["reinstat*", "return*", "restored"]
