# Environment variables
.env

# Position and the watch set (backlog task 013, 2026-08-31).
# These name real decisions, deadlines, exposures and beliefs. They belong in
# the operator's PRIVATE repo -- under version control there, because the
# quarterly review's value is the diff -- and never in this public one. Point
# POSITION_PATH / WATCHES_PATH at them; the defaults live outside any checkout.
# The *.example.yaml files in config/ are committed and are not matched here.
/position.yaml
/watches.yaml
config/position.yaml
config/watches.yaml

# User profile and personal configuration (contains personal information)
config/user_profile.json
config/context_modules/core/decision_context.json
config/api_sources.json

# Claude Code local settings
.claude/settings.local.json

# Philosophical documentation (not for version control)
docs/philosophical_docs/

# Database files
*.db
*.db-journal
*.db-wal
*.db-shm

# Forecast artifacts (forecast subsystem itself goes away in Stage 8)
/reports/forecasts/*.html
/reports/forecasts/*.json

# Logs
src/logs/*.log
*.log

# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

